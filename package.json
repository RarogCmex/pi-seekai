{
  "name": "@rarogcmex/pi-seekai",
  "version": "0.1.2",
  "description": "seekai.cc provider for pi — curated chat catalog (openai-completions), /login, a live /v1/models overlay, and a readable error layer for new-api's 503/403/401/429 shapes.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RarogCmex/pi-seekai.git"
  },
  "bugs": {
    "url": "https://github.com/RarogCmex/pi-seekai/issues"
  },
  "homepage": "https://github.com/RarogCmex/pi-seekai#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "seekai",
    "openai-compat",
    "new-api"
  ],
  "scripts": {
    "test": "node --test --import ./test/no-network.ts 'test/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "live": "node live/check.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
